# Iraqi Family Physicians Society (IFPS) Website Environment Variables
# Copy this file to .env and fill in your Supabase project credentials

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon (Publishable) Key (found in Supabase Dashboard -> Project Settings -> API)
# NEVER put your Service Role Key here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Society Identity System URL (default: https://id.iraqifps.org)
VITE_ID_SYSTEM_URL=https://id.iraqifps.org
